{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/fabric/:id",
      "destination": "/api/listing/:id"
    },
    {
      "source": "/atelier/:id",
      "destination": "/api/atelier/:id"
    },
    {
      "source": "/l/:slug",
      "destination": "/listing.html?id=:slug"
    },
    {
      "source": "/shop/:slug",
      "destination": "/atelier.html?shop=:slug"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/process-orders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/check-saved-searches",
      "schedule": "0 */6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/ThreadTalk.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/showcase.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cosplay.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/stitch-school.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pattern-hacks.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tailoring.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/before-after.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/loose-threads.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fabric-concierge.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/thread/:id",
      "destination": "/",
      "permanent": true
    }
  ]
}
